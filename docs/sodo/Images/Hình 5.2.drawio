        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class IRepository~T~ {\n        &lt;&lt;interface&gt;&gt;\n        +TimTheoId(id : int) T\n        +Them(e : T) void\n        +LuuThayDoi() void\n    }\n    class ILoVaccineRepository {\n        &lt;&lt;interface&gt;&gt;\n        +TimTheoSoLo(soLo : string) LoVaccine\n        +LayLoConHan(vaccineId : int) List~LoVaccine~\n    }\n    class ILichTiemRepository {\n        &lt;&lt;interface&gt;&gt;\n        +LayLichToiHan(tuNgay, soNgay) List~LichTiem~\n    }\n    class IMuiTiemRepository {\n        &lt;&lt;interface&gt;&gt;\n        +LayTheoLo(loId : int) List~MuiTiem~\n        +LayTheoNguoi(nguoiId : int) List~MuiTiem~\n    }\n    class IBienDongLoRepository {\n        &lt;&lt;interface&gt;&gt;\n        +ListGanDay(soLuong : int) List~BienDongLo~\n        +Luu(bd : BienDongLo) void\n    }\n    class INhacLichSender {\n        &lt;&lt;interface&gt;&gt;\n        +Gui(nhac : NhacLich) bool\n    }\n    class IChongChiDinhPolicy {\n        &lt;&lt;interface&gt;&gt;\n        +KiemTra(nguoiTiemId : int, vaccineId : int) void\n    }\n    class IKhoangCachMuiPolicy {\n        &lt;&lt;interface&gt;&gt;\n        +KiemTra(muiTruoc : LichTiem, ngayHen : DateOnly, vaccine : Vaccine) void\n    }\n    class EmailSender\n    class SmsSender\n    class ChongChiDinhPolicy\n    class KhoangCachMuiPolicy\n    class BienDongLoService\n    class NhacLichService\n    class MuiTiemService\n    class LichTiemService\n\n    IRepository &lt;|-- ILoVaccineRepository\n    IRepository &lt;|-- ILichTiemRepository\n    IRepository &lt;|-- IMuiTiemRepository\n    INhacLichSender &lt;|.. EmailSender\n    INhacLichSender &lt;|.. SmsSender\n    IChongChiDinhPolicy &lt;|.. ChongChiDinhPolicy\n    IKhoangCachMuiPolicy &lt;|.. KhoangCachMuiPolicy\n\n    BienDongLoService --&gt; IBienDongLoRepository\n    BienDongLoService --&gt; ILoVaccineRepository\n    NhacLichService --&gt; INhacLichSender\n    NhacLichService --&