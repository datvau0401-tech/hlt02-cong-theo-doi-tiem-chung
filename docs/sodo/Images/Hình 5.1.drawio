        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class NguoiDung {\n        -Id : int\n        -SubjectOidc : string\n        -HoTen : string\n        -VaiTro : VaiTro\n        +LaNhanVienYTe() bool\n    }\n    class ThamSoHeThong {\n        -TenThamSo : string\n        -GiaTri : string\n        -MoTa : string\n    }\n    class NguoiTiem {\n        -Id : int\n        -HoTen : string\n        -NgaySinh : DateOnly\n        -GioiTinh : string\n        -SoDienThoai : string\n        -Email : string\n        +TinhTuoi(ngay : DateOnly) int\n        +CapNhatLienHe(sdt : string, email : string) void\n    }\n    class Vaccine {\n        -Id : int\n        -Ten : string\n        -NhaSanXuat : string\n        -SoMui : int\n        -KhoangCachNgay : int\n        +NgayMuiKeTiep(ngayTruoc : DateOnly) DateOnly\n    }\n    class LoVaccine {\n        -Id : int\n        -SoLo : string\n        -HanDung : DateOnly\n        -SoLuongNhap : int\n        -SoLuongCon : int\n        -NgayNhap : DateTime\n        +NhapMoi(vaccineId, soLo, hanDung, soLuong) LoVaccine$\n        +ConHanDung(ngay : DateOnly) bool\n        +TruSoLuong() void\n    }\n    class ChongChiDinh {\n        -Id : int\n        -LyDo : string\n        -TrangThai : TrangThaiCCD\n        -NgayXacNhan : DateTime\n        -NgayGhiNhan : DateTime\n        +XacNhan(nguoiDungId : int) void\n        +ThuHoi() void\n        +DangCoHieuLuc() bool\n    }\n    class LichTiem {\n        -Id : int\n        -MuiThu : int\n        -NgayHen : DateOnly\n        -TrangThai : TrangThaiLich\n        +DoiNgayHen(ngay : DateOnly) void\n        +Huy() void\n        +DanhDauDaTiem() void\n    }\n    class NhacLich {\n        -Id : int\n        -ThoiDiemGui : DateTime\n        -Kenh : KenhNhac\n        -TrangThai : TrangThaiNhac\n        +DanhDauDaGui() void\n        +DanhDauLoi() void\n    }\n    class MuiTiem {\n        -Id : int\n        -NgayGioTiem : DateTime\n        +GhiNhan(lich, lo, nhanVienId, coCCD, daTiemMuiTruoc) MuiTiem$\n    }\n    class BienDongLo {\n        -Id : long\n        -Loai : LoaiBienDong\n        -SoLuong : int\n        -ThoiDiem : DateTime\n        -LyDo : string\n        +GhiNhan(lo, loai, soLuong, nguoiId, lyDo) BienDongLo$\n    }\n    class NhatKyHieuChinh {\n        -Id : long\n        -TenBang : string\n        -MaBanGhi : string\n        -HanhDong : HanhDongHieuChinh\n        -GiaTriCu : string\n        -GiaTriMoi : string\n        -ThoiDiem : DateTime\n        -LyDo : string\n    }\n    class VaiTro {\n        &lt;&lt;enumeration&gt;&gt;\n        NguoiDan\n        NhanVienYTe\n        QuanTri\n    }\n    class TrangThaiCCD {\n        &lt;&lt;enumeration&gt;&gt;\n        ChuaXacNhan\n        DaXacNhan\n        DaThuHoi\n    }\n    class TrangThaiLich {\n        &lt;&lt;enumeration&gt;&gt;\n        ChoTiem\n        DaTiem\n        DaHuy\n    }\n    class TrangThaiNhac {\n        &lt;&lt;enumeration&gt;&gt;\n        ChoGui\n        DaGui\n        Loi\n    }\n    class KenhNhac {\n        &lt;&lt;enumeration&gt;&gt;\n        Email\n        SMS\n    }\n    class HanhDongHieuChinh {\n        &lt;&lt;enumeration&gt;&gt;\n        THEM\n        SUA\n        HUY\n    }\n    class LoaiBienDong {\n        &lt;&lt;enumeration&gt;&gt;\n        NhapThem\n        Hong\n        HaoHut\n        Huy\n    }\n\n    NguoiDung \&quot;0..1\&quot; -- \&quot;0..*\&quot; ChongChiDinh : xác nhận\n    NguoiDung \&quot;0..1\&quot; -- \&quot;0..1\&quot; NguoiTiem : đại diện\n    NguoiDung \&quot;0..1\&quot; -- \&quot;0..*\&quot; NhatKyHieuChinh\n    NguoiDung \&quot;1\&quot; -- \&quot;0..*\&quot; MuiTiem : thực hiện\n    NguoiDung \&quot;1\&quot; -- \&quot;0..*\&quot; BienDongLo : thực hiện\n    NguoiTiem \&quot;1\&quot; -- \&quot;0..*\&quot; ChongChiDinh\n    NguoiTiem \&quot;1\&quot; -- \&quot;0..*\&quot; LichTiem\n    Vaccine \&quot;1\&quot; -- \&quot;0..*\&quot; ChongChiDinh\n    Vaccine \&quot;1\&quot; -- \&quot;0..*\&quot; LichTiem\n    Vaccine \&quot;1\&quot; -- \&quot;0..*\&quot; LoVaccine\n    LichTiem \&quot;1\&quot; -- \&quot;0..*\&quot; NhacLich\n    LichTiem \&quot;1\&quot; -- \&quot;0..1\&quot; MuiTiem\n    LoVaccine \&quot;1\&quot; -- \&quot;0..*\&quot; MuiTiem\n    LoVaccine \&quot;1\&quot; -- \&quot;0..*\&quot; BienDongLo\n\n    NguoiDung ..&gt; VaiTro\n    ChongChiDinh ..&gt; TrangThaiCCD\n    LichTiem ..&gt; TrangThaiLich\n    NhacLich ..&gt; TrangThaiNhac\n    NhacLich ..&gt; KenhNhac\n    NhatKyHieuChinh ..&gt; HanhDongHieuChinh\n    BienDongLo ..&gt; LoaiBienDong\n```&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="KS2FB-KETUeM0ystBkgZ-1789">
