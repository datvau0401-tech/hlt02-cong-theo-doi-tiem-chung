        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ChongChiDinh {\n        int Id PK\n        int NguoiTiemId FK\n        int VaccineId FK\n        nvarchar LyDo\n        varchar TrangThai FK\n        int NguoiXacNhanId FK\n        datetime2 NgayXacNhan\n        datetime2 NgayGhiNhan\n    }\n    NhatKyHieuChinh {\n        bigint Id PK\n        varchar TenBang\n        varchar MaBanGhi\n        varchar HanhDong FK\n        nvarchar(max) GiaTriCu\n        nvarchar(max) GiaTriMoi\n        int NguoiSuaId FK\n        datetime2 ThoiDiem\n        nvarchar LyDo\n    }\n    BienDongLo {\n        bigint Id PK\n        int LoVaccineId FK\n        varchar Loai FK\n        int SoLuong\n        datetime2 ThoiDiem\n        int NguoiThucHienId FK\n        nvarchar LyDo\n    }\n    MuiTiem {\n        int Id PK\n        int LichTiemId FK, UK\n        int LoVaccineId FK\n        int NhanVienId FK\n        datetime2 NgayGioTiem\n    }\n    NhacLich {\n        int Id PK\n        int LichTiemId FK\n        datetime2 ThoiDiemGui\n        varchar Kenh FK\n        varchar TrangThai FK\n    }\n    ThamSoHeThong {\n        varchar TenThamSo PK\n        nvarchar GiaTri\n        nvarchar MoTa\n    }\n    NguoiDung {\n        int Id PK\n        varchar SubjectOidc UK\n        nvarchar HoTen\n        varchar VaiTro FK\n        int NguoiTiemId FK, UK\n    }\n    LichTiem {\n        int Id PK\n        int NguoiTiemId FK\n        int VaccineId FK\n        int MuiThu\n        date NgayHen\n        varchar TrangThai FK\n    }\n    Vaccine {\n        int Id PK\n        nvarchar Ten UK\n        nvarchar NhaSanXuat\n        int SoMui\n        int KhoangCachNgay\n    }\n    DM_TrangThaiCCD {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_HanhDong {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_LoaiBienDong {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_VaiTro {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_GioiTinh {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_TrangThaiLich {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_KenhNhac {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    DM_TrangThaiNhac {\n        varchar Ma PK\n        nvarchar Ten\n    }\n    LoVaccine {\n        int Id PK\n        int VaccineId FK\n        varchar SoLo\n        date HanDung\n        int SoLuongNhap\n        int SoLuongCon\n        datetime2 NgayNhap\n    }\n    NguoiTiem {\n        int Id PK\n        nvarchar HoTen\n        date NgaySinh\n        varchar GioiTinh FK\n        varchar SoDienThoai\n        varchar Email\n    }\n\n    DM_TrangThaiCCD ||--o{ ChongChiDinh : TrangThai\n    NguoiDung |o--o{ ChongChiDinh : NguoiXacNhanId\n    NguoiTiem ||--o{ ChongChiDinh : NguoiTiemId\n    Vaccine ||--o{ ChongChiDinh : VaccineId\n    DM_HanhDong ||--o{ NhatKyHieuChinh : HanhDong\n    NguoiDung |o--o{ NhatKyHieuChinh : NguoiSuaId\n    LoVaccine ||--o{ BienDongLo : LoVaccineId\n    DM_LoaiBienDong ||--o{ BienDongLo : Loai\n    NguoiDung ||--o{ BienDongLo : NguoiThucHienId\n    LoVaccine ||--o{ MuiTiem : LoVaccineId\n    LichTiem ||--o| MuiTiem : LichTiemId\n    NguoiDung ||--o{ MuiTiem : NhanVienId\n    LichTiem ||--o{ NhacLich : LichTiemId\n    DM_KenhNhac ||--o{ NhacLich : Kenh\n    DM_TrangThaiNhac ||--o{ NhacLich : TrangThai\n    Vaccine ||--o{ LoVaccine : VaccineId\n    Vaccine ||--o{ LichTiem : VaccineId\n    NguoiTiem ||--o{ LichTiem : NguoiTiemId\n    DM_TrangThaiLich ||--o{ LichTiem : TrangThai\n    DM_VaiTro ||--o{ NguoiDung : VaiTro\n    NguoiTiem |o--o| NguoiDung : NguoiTiemId\n    DM_GioiTinh ||--o{ NguoiTiem : GioiTinh\n```\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="KS2FB-KETUeM0ystBkgZ-988">
